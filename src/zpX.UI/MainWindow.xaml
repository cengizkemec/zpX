<Window x:Class="zpX.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:zpX.UI.Controls"
        Title="zpX" 
        Height="650" Width="950" 
        MinHeight="500" MinWidth="800"
        WindowStyle="None" 
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <controls:TitleBar Grid.Row="0"/>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Background="{DynamicResource ToolbarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Content="←" Width="28" Height="28" Margin="2,0"/>
                    <Button Content="→" Width="28" Height="28" Margin="2,0"/>
                    <Button Content="↑" Width="28" Height="28" Margin="2,0"/>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="8,0"/>
                    <TextBlock Text=">" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0"/>
                    <TextBox x:Name="AddressBox" Width="250" Height="26" Margin="8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search..." Margin="-252,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="OpenBtn" Content="Open" Margin="4,0" Padding="12,4"/>
                    <Button x:Name="ExtractBtn" Content="Extract" Margin="4,0" Padding="12,4"/>
                    <Button x:Name="TestBtn" Content="Test" Margin="4,0" Padding="12,4"/>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="8,0"/>
                    <Button x:Name="ThemeBtn" Content="Theme" Margin="4,0" Padding="10,4"/>
                    <Button x:Name="LangBtn" Content="EN/TR" Margin="4,0" Padding="10,4"/>
                </StackPanel>
            </Grid>

            <!-- File List -->
            <ListView x:Name="FileList" 
                      Grid.Row="2" 
                      Background="{DynamicResource SurfaceBrush}" 
                      BorderThickness="0" 
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="420" DisplayMemberBinding="{Binding Ad}"/>
                        <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding Boyut}"/>
                        <GridViewColumn Header="Compressed" Width="120" DisplayMemberBinding="{Binding Sıkıştırılmış}"/>
                        <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Tür}"/>
                        <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding Değiştirme}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Status Bar -->
            <Grid Grid.Row="3" Background="{DynamicResource ToolbarBrush}">
                <TextBlock x:Name="StatusText" 
                           Text="Ready" 
                           Margin="12,0,0,0" 
                           VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>
