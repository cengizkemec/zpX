<Window x:Class="zpX.UI.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PanelBrush}" Margin="0,0,12,0">
                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="TypeText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="General">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Location:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="LocationText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SizeText" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Packed:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="PackedText" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="ModifiedText" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Attributes:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="AttributesText" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Created:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock x:Name="CreatedText" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                </Grid>
            </TabItem>
            <TabItem Header="Hashes">
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="ComputeHashesButton" Content="Compute hashes" Click="ComputeHashesButton_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MD5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox x:Name="Md5Box" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA-1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox x:Name="Sha1Box" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox x:Name="Sha256Box" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA-512" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox x:Name="Sha512Box" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,4"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6" Margin="0,12,0,0"/>
    </Grid>
</Window>
