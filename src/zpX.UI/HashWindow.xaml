<Window x:Class="zpX.UI.HashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hash" Height="420" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="ComputeButton" Content="Compute SHA-256" Click="ComputeButton_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="CopyButton" Content="Copy all" Click="CopyButton_Click" Padding="12,6"/>
        </StackPanel>
        <ListView x:Name="HashList" Grid.Row="1" ItemContainerStyle="{StaticResource FileRow}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="320" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="SHA-256" Width="360" DisplayMemberBinding="{Binding Hash}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Window>
