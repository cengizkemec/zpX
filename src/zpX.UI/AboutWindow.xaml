<Window x:Class="zpX.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About zpX" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource PanelBrush}" Margin="0,0,14,0">
                <Image Source="Assets/app.ico" Width="32" Height="32"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="zpX" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Version 0.7.1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="A modern archive tool inspired by 7-Zip and Telegram." TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Margin="0,2"><Run FontWeight="SemiBold" Text="Publisher: "/><Run Text="Cengiz Kemeç"/></TextBlock>
            <TextBlock Margin="0,2"><Run FontWeight="SemiBold" Text="Website: "/><Hyperlink NavigateUri="https://cengizkemec.com.tr/" RequestNavigate="Link_RequestNavigate">https://cengizkemec.com.tr/</Hyperlink></TextBlock>
            <TextBlock Margin="0,2"><Run FontWeight="SemiBold" Text="GitHub: "/><Hyperlink NavigateUri="https://github.com/cengizkemec" RequestNavigate="Link_RequestNavigate">https://github.com/cengizkemec</Hyperlink></TextBlock>
            <TextBlock Margin="0,2"><Run FontWeight="SemiBold" Text="Repository: "/><Hyperlink NavigateUri="https://github.com/cengizkemec/zpX" RequestNavigate="Link_RequestNavigate">github.com/cengizkemec/zpX</Hyperlink></TextBlock>
            <TextBlock Margin="0,8" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Licensed under MIT. Built with C# + WPF on .NET 9."/>
        </StackPanel>

        <Button Grid.Row="2" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6" Margin="0,12,0,0"/>
    </Grid>
</Window>
